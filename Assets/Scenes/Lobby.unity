  localizedTexts:
  - uiText: {fileID: 0}
    uiText2: {fileID: 0}
    englishText: '<b>Developers:</b><br> Me<br> My schizophrenia<br> Egor (also me)<br>
      ChatGPT<br> DeepSeek<br> <br> You can contact me via Discord or Telegram:<br>
      <b>Discord:</b> egor_qwerty3<br> <b>Telegram:</b> @EgorRoge2<br> <br> I''m
      also often active on the official <i>TUB: Gravity Sandbox</i> server.'
    russianText: "<b>\u0420\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0447\u0438\u043A\u0438:</b><br>
      \u042F<br> \u041C\u043E\u044F \u0448\u0438\u0437\u043E\u0444\u0440\u0435\u043D\u0438\u044F<br>
      \u0415\u0433\u043E\u0440 (\u0442\u043E\u0436\u0435 \u044F)<br> ChatGPT<br>
      DeepSeek<br> <br> \u0412\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u0441\u0432\u044F\u0437\u0430\u0442\u044C\u0441\u044F
      \u0441\u043E \u043C\u043D\u043E\u0439 \u0447\u0435\u0440\u0435\u0437 Discord
      \u0438\u043B\u0438 Telegram:<br> <b>Discord:</b> egor_qwerty3<br> <b>Telegram:</b>
      @EgorRoge2<br> <br> \u0422\u0430\u043A\u0436\u0435 \u044F \u0447\u0430\u0441\u0442\u043E
      \u043F\u043E\u044F\u0432\u043B\u044F\u044E\u0441\u044C \u043D\u0430 \u043E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u043C
      \u0441\u0435\u0440\u0432\u0435\u0440\u0435 <i>TUB: Gravity Sandbox</i>.<br>
      <br>"
  - uiText: {fileID: 0}
    uiText2: {fileID: 0}
    englishText: Save decryption
    russianText: "\u0420\u0430\u0441\u0448\u0438\u0444\u0440\u043E\u0432\u0430\u0442\u044C
      \u0421\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0435"
