    russianText: "\u0412\u044B\u0445\u043E\u0434"
  - uiText: {fileID: 429193339}
    uiText2: {fileID: 0}
    englishText: Write save name to load.
    russianText: "\u0412\u0432\u0435\u0434\u0438\u0442\u0435 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435
      \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F \u0434\u043B\u044F
      \u0437\u0430\u0433\u0440\u0443\u0437\u043A\u0438."
  - uiText: {fileID: 0}
    uiText2: {fileID: 1254803612}
    englishText: Load Save
    russianText: "\u0417\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044C \u0421\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0435"
  - uiText: {fileID: 394155542}
    uiText2: {fileID: 0}
    englishText: Settings
    russianText: "\u041D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438"
  - uiText: {fileID: 394155542}
    uiText2: {fileID: 0}
    englishText: Settings
    russianText: "\u041D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438"
  - uiText: {fileID: 2052361584}
    uiText2: {fileID: 0}
    englishText: Select graphic settings
    russianText: "\u0412\u044B\u0431\u0440\u0430\u0442\u044C \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438
      \u0433\u0440\u0430\u0444\u0438\u043A\u0438"
  - uiText: {fileID: 0}
    uiText2: {fileID: 608508101}
    englishText: Close
    russianText: "\u0417\u0430\u043A\u0440\u044B\u0442\u044C"
  - uiText: {fileID: 261684975}
    uiText2: {fileID: 0}
    englishText: Low
    russianText: "\u041D\u0438\u0437\u043A\u0438\u0435"
  - uiText: {fileID: 503981676}
    uiText2: {fileID: 0}
    englishText: Medium
    russianText: "\u0421\u0440\u0435\u0434\u043D\u0438\u0435"
  - uiText: {fileID: 1849135665}
    uiText2: {fileID: 0}
    englishText: High
    russianText: "\u0412\u044B\u0441\u043E\u043A\u0438\u0435"
  - uiText: {fileID: 1358784435}
    uiText2: {fileID: 0}
    englishText: Ultra
    russianText: "\u0423\u043B\u044C\u0442\u0440\u0430"
  - uiText: {fileID: 1404488118}
    uiText2: {fileID: 0}
    englishText: Ultra +++
    russianText: "\u0423\u043B\u044C\u0442\u0440\u0430 +++"
  - uiText: {fileID: 0}
    uiText2: {fileID: 857047340}
    englishText: Close
    russianText: "\u0417\u0430\u043A\u0440\u044B\u0442\u044C"
  - uiText: {fileID: 0}
    uiText2: {fileID: 1273724231}
    englishText: Decrypt
    russianText: "\u0420\u0430\u0441\u0448\u0438\u0444\u0440\u043E\u0432\u0430\u0442\u044C"
  - uiText: {fileID: 420439805}
    uiText2: {fileID: 0}
    englishText: Path to the folder for the decrypted file.
    russianText: "\u041F\u0443\u0442\u044C \u043A \u043F\u0430\u043F\u043A\u0435
      \u0434\u043B\u044F \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0433\u043E
      \u0444\u0430\u0439\u043B\u0430."
  - uiText: {fileID: 1105484544}
    uiText2: {fileID: 0}
    englishText: Path to <b>.save</b> file to decrypt.
    russianText: "\u041F\u0443\u0442\u044C \u043A \u0444\u0430\u0439\u043B\u0443
      <b>.save</b> \u0434\u043B\u044F \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043E\u0432\u043A\u0438."
  - uiText: {fileID: 1054376143}
    uiText2: {fileID: 0}
    englishText: Download
    russianText: "\u0421\u043A\u0430\u0447\u0430\u0442\u044C"
  - uiText: {fileID: 368243686}
    uiText2: {fileID: 0}
    englishText: It looks like a new version of TUBMapTool is available! Install
      it by clicking the button below.
    russianText: "\u041F\u043E\u0445\u043E\u0436\u0435 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0430
      \u043D\u043E\u0432\u0430\u044F \u0432\u0435\u0440\u0441\u0438\u044F TUBMapTool!
      \u0423\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435 \u0435\u0451 \u043D\u0430\u0436\u0430\u0432
      \u043A\u043D\u043E\u043F\u043A\u0443 \u043D\u0438\u0436\u0435."
  - uiText: {fileID: 702323034}
    uiText2: {fileID: 0}
    englishText: Settings
    russianText: "\u041D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438"
  - uiText: {fileID: 1645640273}
    uiText2: {fileID: 0}
    englishText: Build
    russianText: "\u0421\u0442\u0440\u043E\u0438\u0442\u044C"
  - uiText: {fileID: 0}
    uiText2: {fileID: 0}
    englishText: Decrypt
    russianText: "\u0420\u0430\u0441\u0448\u0438\u0444\u0440\u043E\u0432\u0430\u0442\u044C"
  - uiText: {fileID: 1657448954}
    uiText2: {fileID: 0}
    englishText: Exit
    russianText: "\u0412\u044B\u0445\u043E\u0434"
