  m_Script: {fileID: 11500000, guid: 4eea47774a83f50488abcfa3724e0ea7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  localizedTexts:
  - uiTextTMP: {fileID: 8806249641595598404}
    uiText: {fileID: 0}
    englishText: Save Map
    russianText: "\u0421\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C \u043A\u0430\u0440\u0442\u0443"
  - uiTextTMP: {fileID: 3951061686483564991}
    uiText: {fileID: 0}
    englishText: Settings
    russianText: "\u041D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438"
  - uiTextTMP: {fileID: 8296441658510544387}
    uiText: {fileID: 0}
    englishText: EXIT
    russianText: "\u0412\u044B\u0445\u043E\u0434"
  - uiTextTMP: {fileID: 8309568335247807019}
    uiText: {fileID: 0}
    englishText: Load Map
    russianText: "3\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044C \u043A\u0430\u0440\u0442\u0443"
  - uiTextTMP: {fileID: 0}
    uiText: {fileID: 966332490030221011}
    englishText: FOG
    russianText: "\u0422\u0423\u041C\u0410\u041D"
  - uiTextTMP: {fileID: 0}
    uiText: {fileID: 0}
    englishText: Enter the name of the object to spawn.
    russianText: "\u0412\u0432\u0435\u0434\u0438\u0442\u0435 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435
      \u043E\u0431\u044A\u0435\u043A\u0442\u0430 \u0434\u043B\u044F \u0441\u043F\u0430\u0432\u043D\u0430."
  - uiTextTMP: {fileID: 0}
    uiText: {fileID: 9015863419760474947}
    englishText: Click to spawn an object by name.
    russianText: "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \u0434\u043B\u044F \u0441\u043F\u0430\u0432\u043D\u0430
      \u043E\u0431\u044A\u0435\u043A\u0442\u0430 \u043F\u043E \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u044E."
  - uiTextTMP: {fileID: 0}
    uiText: {fileID: 9015863419760474947}
    englishText: Click to spawn an object by name.
    russianText: "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \u0434\u043B\u044F \u0441\u043F\u0430\u0432\u043D\u0430
      \u043E\u0431\u044A\u0435\u043A\u0442\u0430 \u043F\u043E \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u044E."
  - uiTextTMP: {fileID: 0}
    uiText: {fileID: 0}
    englishText: Close
    russianText: "\u0417\u0430\u043A\u0440\u044B\u0442\u044C"
  - uiTextTMP: {fileID: 7806373440889715010}
    uiText: {fileID: 0}
    englishText: <size=50>Save Folder Path:</size> <color=red>{spath}
    russianText: "<size=50>\u0421\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u043E
      \u043F\u043E \u043F\u0443\u0442\u0438:</size> <color=red>{spath}"
  - uiTextTMP: {fileID: 4006975392650881343}
    uiText: {fileID: 0}
    englishText: Enter a save name
    russianText: "\u0412\u0432\u0435\u0434\u0438\u0442\u0435 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435
      \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F"
  - uiTextTMP: {fileID: 0}
    uiText: {fileID: 2517688022651974913}
    englishText: Save Map
    russianText: "\u0421\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C \u041A\u0430\u0440\u0442\u0443"
  - uiTextTMP: {fileID: 0}
    uiText: {fileID: 6905995603675087242}
    englishText: Close
    russianText: "\u0417\u0430\u043A\u0440\u044B\u0442\u044C"
  - uiTextTMP: {fileID: 0}
    uiText: {fileID: 0}
    englishText: Enter a name for the save to load.
    russianText: "\u0412\u0432\u0435\u0434\u0438\u0442\u0435 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435
      \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F \u0434\u043B\u044F
      \u0437\u0430\u0433\u0440\u0443\u0437\u043A\u0438."
  - uiTextTMP: {fileID: 0}
    uiText: {fileID: 0}
    englishText: Loading a save with a large number of objects may cause temporary
      freezes.
    russianText: "3\u0430\u0433\u0440\u0443\u0437\u043A\u0430 \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0439
      \u0441 \u0431\u043E\u043B\u044C\u0448\u0438\u043C \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E\u043C
      \u043E\u0431\u044A\u0435\u043A\u0442\u043E\u0432 \u043C\u043E\u0436\u0435\u0442
      \u0441\u043F\u0440\u043E\u0432\u043E\u0446\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0435 \u0437\u0430\u0432\u0438\u0441\u0430\u043D\u0438\u044F."
  - uiTextTMP: {fileID: 0}
    uiText: {fileID: 0}
    englishText: Load
    russianText: "\u0417\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044C"
  - uiTextTMP: {fileID: 0}
    uiText: {fileID: 0}
    englishText: Close
    russianText: "\u0417\u0430\u043A\u0440\u044B\u0442\u044C"
  - uiTextTMP: {fileID: 5805225855716275345}
    uiText: {fileID: 0}
    englishText: All
    russianText: "\u0412\u0441\u0435"
  - uiTextTMP: {fileID: 4404060666889837583}
    uiText: {fileID: 0}
    englishText: Available
    russianText: "\u0414\u043E\u0441\u0442\u0443\u043F\u043D\u044B\u0435"
  - uiTextTMP: {fileID: 0}
    uiText: {fileID: 7475312695109196121}
    englishText: NIGHT
    russianText: "\u041D\u041E\u0427\u042C"
  - uiTextTMP: {fileID: 3834431243441402504}
    uiText: {fileID: 0}
    englishText: Graphic
    russianText: "\u0413\u0440\u0430\u0444\u0438\u043A\u0430"
  - uiTextTMP: {fileID: 3864494436896001829}
    uiText: {fileID: 0}
    englishText: Controls
    russianText: "\u0423\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435"
  - uiTextTMP: {fileID: 7481747740606493656}
    uiText: {fileID: 0}
    englishText: Make screenshot
    russianText: "\u0421\u0434\u0435\u043B\u0430\u0442\u044C \u0441\u043D\u0438\u043C\u043E\u043A
      \u044D\u043A\u0440\u0430\u043D\u0430"
  - uiTextTMP: {fileID: 7567415043049767602}
    uiText: {fileID: 0}
